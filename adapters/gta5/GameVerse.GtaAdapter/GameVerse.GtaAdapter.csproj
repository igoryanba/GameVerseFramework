<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyName>GameVerse.GtaAdapter</AssemblyName>
    <ShvdnePath Condition="'$(ShvdnePath)' == ''">$(MSBuildThisFileDirectory)..\vendor\shvdne</ShvdnePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="ScriptHookVDotNet3"><HintPath>$(ShvdnePath)\ScriptHookVDotNet3.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="..\protocol\*.cs" Link="Protocol\%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RequireShvdne" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ShvdnePath)\ScriptHookVDotNet3.dll')" Text="SHVDNE v1.1.0.6 is required. Run setup.ps1 or pass -p:ShvdnePath=..." />
  </Target>
</Project>
